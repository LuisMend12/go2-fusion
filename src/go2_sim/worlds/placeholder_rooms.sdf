<?xml version="1.0"?>
<!--
  Placeholder world for the Oak simulator: a 10 x 8 m flat with four rooms,
  1.2 m doorways (two routes round, so SLAM can close a loop) and some
  furniture boxes. Not the real lab: Jeth's tape-measured lab world (issue #28)
  replaces it via `world:=`.

  Ground truth for scoring is built from the box and cylinder collisions below
  (go2_sim world_tools), so keep obstacles as boxes/cylinders, or ship a
  <world>.gt.yaml map next to the world file.
-->
<sdf version="1.8">
  <world name="placeholder_rooms">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Walls, 2 m high, 0.15 m thick -->
    <model name="outer_south">
      <static>true</static>
      <pose>5 0 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.15 0.15 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.15 0.15 2.0</size></box></geometry>
          <material><ambient>0.9 0.88 0.8 1</ambient><diffuse>0.9 0.88 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="outer_north">
      <static>true</static>
      <pose>5 8 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.15 0.15 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.15 0.15 2.0</size></box></geometry>
          <material><ambient>0.9 0.88 0.8 1</ambient><diffuse>0.9 0.88 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="outer_west">
      <static>true</static>
      <pose>0 4 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 8.15 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 8.15 2.0</size></box></geometry>
          <material><ambient>0.9 0.88 0.8 1</ambient><diffuse>0.9 0.88 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="outer_east">
      <static>true</static>
      <pose>10 4 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 8.15 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 8.15 2.0</size></box></geometry>
          <material><ambient>0.9 0.88 0.8 1</ambient><diffuse>0.9 0.88 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="mid_x5_a">
      <static>true</static>
      <pose>5 0.75 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 1.5 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 1.5 2.0</size></box></geometry>
          <material><ambient>0.9 0.88 0.8 1</ambient><diffuse>0.9 0.88 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="mid_x5_b">
      <static>true</static>
      <pose>5 4.35 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 3.3 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 3.3 2.0</size></box></geometry>
          <material><ambient>0.9 0.88 0.8 1</ambient><diffuse>0.9 0.88 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="mid_x5_c">
      <static>true</static>
      <pose>5 7.6 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.8 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.8 2.0</size></box></geometry>
          <material><ambient>0.9 0.88 0.8 1</ambient><diffuse>0.9 0.88 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="west_y4_a">
      <static>true</static>
      <pose>0.75 4 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 0.15 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 0.15 2.0</size></box></geometry>
          <material><ambient>0.9 0.88 0.8 1</ambient><diffuse>0.9 0.88 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="west_y4_b">
      <static>true</static>
      <pose>3.85 4 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.3 0.15 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.3 0.15 2.0</size></box></geometry>
          <material><ambient>0.9 0.88 0.8 1</ambient><diffuse>0.9 0.88 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="east_y5_a">
      <static>true</static>
      <pose>6.0 5 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.15 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.15 2.0</size></box></geometry>
          <material><ambient>0.9 0.88 0.8 1</ambient><diffuse>0.9 0.88 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="east_y5_b">
      <static>true</static>
      <pose>9.1 5 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.8 0.15 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.8 0.15 2.0</size></box></geometry>
          <material><ambient>0.9 0.88 0.8 1</ambient><diffuse>0.9 0.88 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Furniture -->
    <model name="table">
      <static>true</static>
      <pose>1.0 1.0 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.6 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.6 0.75</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="low_cabinet">
      <static>true</static>
      <pose>3.8 2.8 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 0.45</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.8 0.45</size></box></geometry>
          <material><ambient>0.4 0.4 0.6 1</ambient><diffuse>0.4 0.4 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="sofa">
      <static>true</static>
      <pose>2.5 7.4 0.400 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.8 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.8 0.8</size></box></geometry>
          <material><ambient>0.3 0.5 0.3 1</ambient><diffuse>0.3 0.5 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf">
      <static>true</static>
      <pose>9.6 1.5 0.900 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 1.5 1.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 1.5 1.8</size></box></geometry>
          <material><ambient>0.5 0.3 0.2 1</ambient><diffuse>0.5 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate">
      <static>true</static>
      <pose>6.5 3.5 0.250 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.7 0.6 0.3 1</ambient><diffuse>0.7 0.6 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="bin_box">
      <static>true</static>
      <pose>9.0 6.8 0.250 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar">
      <static>true</static>
      <pose>7.5 2.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.15</radius><length>2.0</length></cylinder></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
